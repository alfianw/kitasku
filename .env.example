# ============================================================================
# KONFIGURASI PRODUCTION KITASKU.ID (Domain: kitasku.id | VPS: 187.124.139.200)
# ============================================================================

# Port publik (Nginx Reverse Proxy di port 80)
HTTP_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Kosongkan NEXT_PUBLIC_API_URL karena Nginx Reverse Proxy melayani satu pintu
NEXT_PUBLIC_API_URL=

# Domain / IP VPS yang diizinkan oleh CORS Backend
FRONTEND_URL=https://kitasku.id
ALLOWED_ORIGINS=https://kitasku.id,https://www.kitasku.id,http://kitasku.id,http://www.kitasku.id,http://187.124.139.200,http://187.124.139.200:3000,http://localhost,http://localhost:3000
PUBLIC_BASE_URL=

# Konfigurasi Database PostgreSQL
DB_USER=kitasku
DB_PASSWORD=kitasku_super_secret_db_password_2026
DB_NAME=kitasku

# Keamanan JWT & Upload
JWT_SECRET=kitasku_production_jwt_secret_key_9f8e7d6c5b4a2026
JWT_EXPIRES_HOURS=24
MAX_UPLOAD_MB=10

# Akun Admin Awal Dashboard (/dashbord)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kitasku.id
ADMIN_PASSWORD=admin123
